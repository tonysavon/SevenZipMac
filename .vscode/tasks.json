{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "swift build --scratch-path /tmp/SevenZipMacBuild",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$swiftc"
        },
        {
            "label": "Build & Package 7-Zip.app (Release)",
            "type": "shell",
            "command": "./Scripts/package_app.sh",
            "group": "build",
            "problemMatcher": "$swiftc"
        },
        {
            "label": "Run 7-Zip.app",
            "type": "shell",
            "command": "open \"${workspaceFolder}/7-Zip.app\"",
            "problemMatcher": []
        },
        {
            "label": "Clean Build Cache",
            "type": "shell",
            "command": "rm -rf /tmp/SevenZipMacBuild .build",
            "problemMatcher": []
        }
    ]
}
